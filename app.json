{
  "expo": {
    "name": "Husna EduPay",
    "slug": "husna-edupay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "husnaedupay",
    "deepLinks": ["husnaedupay://callback"],
    "deepLinking": true,
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.husnaedupay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.husnaedupay",
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true,
      "permissions": ["android.permission.READ_PHONE_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "husnaedupay",
            "host": "callback"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan Husna Edu Pay mengakses galeri anda.",
          "savePhotosPermission": "Izinkan Husna Edu Pay menyimpan gambar.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "Izinkan Husna Edu Pay mengakses Kamera.",
          "microphonePermission": "Izinkan Husna Edu Pay mengakses Mikrofon."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "896baf6e-3a94-4747-89e0-1e955a9c7c33"
      }
    },
    "owner": "husnaedupay",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/896baf6e-3a94-4747-89e0-1e955a9c7c33"
    }
  }
}
